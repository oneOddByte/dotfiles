cursor-color = #a8a6b8
config-file = ~/.config/ghostty/ghostty_colors.conf

# --- MODERN RENDERING (The "Magic" Flags) ---
# 'no-hinting' usually gives the most modern, smooth look on Linux
# 'no-bitmap' prevents ugly pixelated fallback fonts
freetype-load-flags = no-hinting

# --- FONT SETTINGS ---
font-size = 13
font-feature = "+liga"

# [ JETBRAINS MONO ]
# This is generally considered the most modern looking terminal font
font-family = "JetBrains Mono"
font-style = "Medium"
adjust-cell-height = 5%

# [ ROBOTO MONO ]
#font-family = "Roboto Mono"
#font-style = "Medium"
#adjust-cell-height = 25%

# [ FIRA CODE ]
#font-family = "Fira Code"
#font-style = "Retina"
#adjust-cell-height = 30%

# [ SF MONO ]
# font-family = "SF Mono"
# font-style = "SemiBold"
# adjust-cell-height = 5%

# --- WINDOW SETTINGS ---
window-padding-x = 20, 3
window-padding-y = 10, 0

# --- THEMES ---
# theme = rose-pine
# theme = "Kanagawa Wave"
