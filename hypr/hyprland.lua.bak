local hypr = {}

-- autogenerated = 1 -- remove this line to remove the warning

------------------
--### MONITORS ###
------------------

hypr.monitor = {
    "eDP-1, 1920x1080@60, 0x0, 1"
}

---------------------
--### MY PROGRAMS ###
---------------------

local terminal = "ghostty"
local browser = "brave"
local fileManager = "nautilus"
local menu = "~/.config/rofi/scripts/app-launcher"

-------------------
--### AUTOSTART ###
-------------------

hypr["exec-once"] = {
    "~/.config/hypr/scripts/startup.sh",
    "bash -c 'sleep 2 && hyprctl plugin load /usr/lib/hyprland-plugins/hyprexpo/libhyprexpo.so'",
    "blueman-applet &",
    -- "albert &",
    "polkit-gnome-authentication-agent-1 &",
    "~/.config/dunst/wal-reload.sh",
    "wlsunset -l 10.99 -L 76.95 -t 5200 -T 6500",
    "tmux",
    "gnome-keyring-daemon --start --components=secrets",
    "copyq --start-server"
}

-- --- Wallpaper & Theme ---
-- "~/.config/hypr/scripts/wall-engine"

-------------------------------
--### ENVIRONMENT VARIABLES ###
-------------------------------

hypr.env = {
    "XCURSOR_SIZE,24",
    "HYPRCURSOR_SIZE,24"
}

-----------------------
--### LOOK AND FEEL ###
-----------------------

hypr.general = {
    no_focus_fallback = true,
    gaps_in = 4,
    gaps_out = 8,
    border_size = 0,
    ["col.active_border"] = "rgba(33ccffee) rgba(00ff99ee) 45deg",
    ["col.inactive_border"] = "rgba(595959aa)",
    resize_on_border = true,
    allow_tearing = false,
    layout = "dwindle"
}

hypr.decoration = {
    rounding = 10,
