hypr.dwindle = {
    pseudotile = true,
    preserve_split = true
}

hypr.master = {
    new_status = "master"
}

hypr.misc = {
    force_default_wallpaper = -1,
    disable_hyprland_logo = false
}

-------------
--### INPUT ###
-------------

hypr.input = {
    kb_layout = "us",
    kb_variant = "",
    kb_model = "",
    kb_options = "caps:super",
    kb_rules = "",
    follow_mouse = 1,
    sensitivity = 0.35,

    touchpad = {
        natural_scroll = true
    }
}

hypr.gesture = "3, horizontal, workspace"

hypr.device = {
    name = "epic-mouse-v1",
    sensitivity = -0.5
}

---------------------
--### KEYBINDINGS ###
---------------------

local mainMod = "SUPER"

-- Helper snippet strings used in your configuration
local d_silent = "[$ws|Navigation|Move window silently]"
local d_resize = "[$wm|Resize Active Window]"
local d_move = "[$wm|Move active window across workspace]"
local moveactivewindow = 'grep -q "true" <<< $(hyprctl activewindow -j | jq -r .floating) && hyprctl dispatch moveactive'

hypr.bind = {
    -- Core Utility & Application Launchers
    "ALT, TAB, workspace, previous",
    mainMod .. ", TAB, exec, hyprctl dispatch hyprexpo:expo toggle",
    "SUPER, W, exec, ~/.config/hypr/scripts/wall-engine.sh",
    "SUPER, X, exec, ~/.config/rofi/scripts/power-manager",
    "SUPER, N, exec, ~/.config/rofi/scripts/wifi-manager",
    "SUPER SHIFT, B, exec, ~/.config/hypr/scripts/toggle-bt.sh",
    mainMod .. ", I, exec, ~/.dotfiles/waybar/scripts/toggle_waybar.sh",
    mainMod .. ", minus, fullscreen, 1",
    mainMod .. ", space, exec, " .. menu,
    mainMod .. " SHIFT, p, pin",
    mainMod .. ", V, exec, copyq toggle",
    ", Print, exec, ~/.config/hypr/scripts/screenshot.sh",
    mainMod .. ", return, exec, " .. terminal,
    mainMod .. " SHIFT, return, exec, " .. browser,
    mainMod .. ", Q, killactive,",
    mainMod .. ", Z, exit,",
    mainMod .. ", E, exec, " .. fileManager,
    mainMod .. ", B, togglefloating,",
    -- mainMod .. ", R, exec, wofi",
    mainMod .. ", P, pseudo,",
    mainMod .. ", T, layoutmsg, togglesplit",
    mainMod .. " CTRL, T, layoutmsg, orientationnext",

    -- Move Focus
    mainMod .. ", h, movefocus, l",
    mainMod .. ", l, movefocus, r",
    mainMod .. ", k, movefocus, u",
    mainMod .. ", j, movefocus, d",
    mainMod .. ", comma,  focusmonitor, l",
    mainMod .. ", period, focusmonitor, r",

    -- Workspace Switching
    mainMod .. ", a, workspace, 1",
    mainMod .. ", s, workspace, 2",
    mainMod .. ", d, workspace, 3",
    mainMod .. ", f, workspace, 4",
    mainMod .. ", g, workspace, 5",
    mainMod .. ", 1, workspace, 6",
    mainMod .. ", 2, workspace, 7",
    mainMod .. ", 3, workspace, 8",
    mainMod .. ", 4, workspace, 9",
    mainMod .. ", 0, workspace, 10",

    -- Move Window to Workspace
    mainMod .. " SHIFT, 1, movetoworkspace, 1",
    mainMod .. " SHIFT, 2, movetoworkspace, 2",
    mainMod .. " SHIFT, 3, movetoworkspace, 3",
    mainMod .. " SHIFT, 4, movetoworkspace, 4",
    mainMod .. " SHIFT, 5, movetoworkspace, 5",
    mainMod .. " SHIFT, 6, movetoworkspace, 6",
    mainMod .. " SHIFT, 7, movetoworkspace, 7",
    mainMod .. " SHIFT, 8, movetoworkspace, 8",
    mainMod .. " SHIFT, 9, movetoworkspace, 9",
    mainMod .. " SHIFT, 0, movetoworkspace, 10",

    -- Special Workspaces
    mainMod .. ", semicolon, togglespecialworkspace, magic",
    mainMod .. " SHIFT, semicolon, movetoworkspace, special:magic",

    -- Mouse scrolling workspaces
    mainMod .. ", mouse_down, workspace, e+1",
    mainMod .. ", mouse_up, workspace, e-1",

    -- "bind = $mainMod, o, exec, wofi --show drun"
}

hypr.bindd = {
    mainMod .. " Alt, 1, " .. d_silent .. " move to workspace 1  (silent), movetoworkspacesilent, 1",
    mainMod .. " Alt, 2, " .. d_silent .. " move to workspace 2  (silent), movetoworkspacesilent, 2",
    mainMod .. " Alt, 3, " .. d_silent .. " move to workspace 3  (silent), movetoworkspacesilent, 3",
    mainMod .. " Alt, 4, " .. d_silent .. " move to workspace 4  (silent), movetoworkspacesilent, 4",
    mainMod .. " Alt, 5, " .. d_silent .. " move to workspace 5  (silent), movetoworkspacesilent, 5",
    mainMod .. " Alt, 6, " .. d_silent .. " move to workspace 6  (silent), movetoworkspacesilent, 6",
    mainMod .. " Alt, 7, " .. d_silent .. " move to workspace 7  (silent), movetoworkspacesilent, 7",
    mainMod .. " Alt, 8, " .. d_silent .. " move to workspace 8  (silent), movetoworkspacesilent, 8",
    mainMod .. " Alt, 9, " .. d_silent .. " move to workspace 9  (silent), movetoworkspacesilent, 9",
    mainMod .. " Alt, 0, " .. d_silent .. " move to workspace 10 (silent), movetoworkspacesilent, 10"
}

hypr.bindde = {
    -- mainMod .. " Shift, Right, " .. d_resize .. " resize window right , resizeactive, 30 0",
    -- mainMod .. " Shift, Left, " .. d_resize .. " resize window left, resizeactive, -30 0",
    -- mainMod .. " Shift, Up, " .. d_resize .. " resize window up, resizeactive, 0 -30",
    -- mainMod .. " Shift, Down, " .. d_resize .. " resize  window down, resizeactive, 0 30",
    mainMod ..
    " Shift Control, h, Move active window to the left, exec, " ..
    moveactivewindow .. " -30 0 || hyprctl dispatch movewindow l",
    mainMod ..
    " Shift Control, l, Move active window to the right, exec, " ..
    moveactivewindow .. " 30 0 || hyprctl dispatch movewindow r",
    mainMod ..
    " Shift Control, k, Move active window up, exec, " .. moveactivewindow .. "  0 -30 || hyprctl dispatch movewindow u",
    mainMod ..
    " Shift Control, j, Move active window down, exec, " .. moveactivewindow .. " 0 30 || hyprctl dispatch movewindow d"
}

-- Submap Definitions
hypr.submaps = {
    resize = {
        binde = {
            ", l, resizeactive, 30 0",
            ", h, resizeactive, -30 0",
            ", k, resizeactive, 0 -30",
            ", j, resizeactive, 0 30"
        },
        bind = {
            ", escape, submap, reset",
            ", return, submap, reset"
        }
    }
}

-- Mouse Bindings
hypr.bindm = {
    mainMod .. ", mouse:272, movewindow",
    mainMod .. ", mouse:273, resizewindow"
}

-- Repeating & Locked Keybinds
hypr.bindel = {
    ",XF86AudioRaiseVolume, exec, swayosd-client --output-volume raise",
    ",XF86AudioLowerVolume, exec, swayosd-client --output-volume lower",
    ",XF86AudioMute, exec, swayosd-client --output-volume mute-toggle",
    ",XF86AudioMicMute, exec, swayosd-client --input-volume mute-toggle",
    ",XF86MonBrightnessUp, exec, swayosd-client --brightness raise",
    ",XF86MonBrightnessDown, exec, swayosd-client --brightness lower"
}

hypr.bindl = {
    ", XF86AudioNext, exec, playerctl next",
    ", XF86AudioPause, exec, playerctl play-pause",
    ", XF86AudioPlay, exec, playerctl play-pause",
    ", XF86AudioPrev, exec, playerctl previous"
}

----------------------------------
--### WINDOWS AND WORKSPACES ###
----------------------------------

-- NEW v0.53 WINDOW RULE SYNTAX
hypr.windowrule = {
    -- Opacity for ghostty terminal
    "opacity 0.98 override 0.845 override, match:class ^(com.mitchellh.ghostty)$",
    "opacity 1.0 override 1.0 override, match:class ^(Alacritty)$",

    -- Ignore maximize requests from apps
    "suppress_event maximize, match:class .*",

    -- Fix some dragging issues with XWayland
    "no_focus on, match:class ^$, match:title ^$, match:xwayland 1, match:float 1, match:fullscreen 0, match:pin 0",

    -- Float file dialogs
    "float on, match:title ^(Open File|Open|Save|Save as|Export|Import|Choose File|Rename)$, match:class ^(.*)$",
    "center on, match:title ^(Open File|Open|Save|Save as|Export|Import|Choose File|Rename)$, match:class ^(.*)$",

    -- Float Google sign-in
    "float on, match:title ^(Sign in – Google accounts - Brave)$",
    "center on, match:title ^(Sign in – Google accounts - Brave)$",

    -- Float portal dialogs
    "float on, match:class (xdg-desktop-portal-gtk)",
    "center on, match:class (xdg-desktop-portal-gtk)",
    "float on, match:class (xdg-desktop-portal-hyprland)",
    "center on, match:class (xdg-desktop-portal-hyprland)",
    "float on, match:class (Xdg-desktop-portal-gtk)",
    "center on, match:class (Xdg-desktop-portal-gtk)",
    "border_size 0, match:class (Xdg-desktop-portal-gtk)",
    "float on, match:class (Xdg-desktop-portal-hyprland)",
    "center on, match:class (Xdg-desktop-portal-hyprland)",

    -- Float common apps
    "float on, match:class (pavucontrol)",
    "float on, match:class (blueman-manager)",
    "float on, match:title ^(bluetui)$",
    "size 900 650, match:title ^(bluetui)$",
    "center on, match:title ^(bluetui)$",
    "float on, match:title ^(btop-popup)$",
    "size 1100 760, match:title ^(btop-popup)$",
    "center on, match:title ^(btop-popup)$",
    "float on, match:class (nm-connection-editor)",
    "float on, match:class (com.github.hluk.copyq)",

    -- Picture-in-Picture - NEW v0.53 SYNTAX
    "tag +picture-in-picture, match:title ^([Pp]icture[-\\s]?[Ii]n[-\\s]?[Pp]icture)(.*)$",
    "float on, match:tag picture-in-picture",
    "move ((monitor_w*0.73)) ((monitor_h*0.72)), match:tag picture-in-picture",
    "min_size 300 200, match:tag picture-in-picture",
    "pin on, match:tag picture-in-picture",

    -- Waybar positioning (if you're using it as a window)
    "float on, match:class (waybar)",
    "size (monitor_w*1) 40, match:class (waybar)",
    "move (0) (10), match:class (waybar)",

    -- Smart gaps additions
    "border_size 0, match:float 0, match:workspace w[tv1]",
    "rounding 0, match:float 0, match:workspace w[tv1]"
}

------------------------------
--### LAYER RULES - NEW v0.53 ###
------------------------------

hypr.layerrule = {
    "blur on, match:namespace waybar",
    "ignore_alpha 0, match:namespace waybar"
}

-------------------------
--### WORKSPACE RULES ###
-------------------------

hypr.workspace = {
    "w[tv1], gapsout:0, gapsin:0",
    "f[1], gapsout:0, gapsin:0"
}

return hypr
