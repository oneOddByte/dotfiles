{
    "layer": "top",
    "position": "top",
    "style": "~/.config/waybar/style.css",
    "margin-top": 6,
    "margin-bottom": 6,
    "margin-left": 12,
    "margin-right": 12,

    "height": 40,
    "spacing": 4,
    "padding": 2,
    "mode": "dock",

    "modules-left":   ["hyprland/window", "group/media"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right":  ["group/system", "group/av", "group/connectivity"],

    // ── Left ──────────────────────────────────────────────────────────────

    "group/media": {
        "orientation": "horizontal",
        "modules": ["clock", "mpris"]
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 30,
        "separate-outputs": true,
        "rewrite": {
            "(.+) — Brave":                "󰖟  Brave",
            "(.+) - Brave":                "󰖟  Brave",
            "(.+) - Visual Studio Code":   "󰨞  Code",
            "(.+) — Mozilla Firefox":      "󰈹  Firefox",
            "(.+) - Mozilla Firefox":      "󰈹  Firefox",
            "(.+) - Cursor":               "󰨞  Cursor",
            "Cursor":                      "󰨞  Cursor",
            "":                            ""
        }
    },

    "clock": {
        "format": "󰸗  {:%I:%M %p}",
        "tooltip-format": "<big>{:%A, %B %d %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "brave https://calendar.google.com/calendar/u/0/r"
    },

    "mpris": {
        "format": "{player_icon}  {title}",
        "format-paused": "⏸  {title}",
        "max-length": 35,
        "player-icons": {
            "default":  "▶",
            "spotify":  "󰓇",
            "firefox":  "󰈹",
            "mpv":      "󰐊"
        },
        "status-icons": {
            "paused": "⏸"
        }
    },

    // ── Right ─────────────────────────────────────────────────────────────

    "group/system": {
        "orientation": "horizontal",
        "modules": ["tray", "custom/launcher", "idle_inhibitor", "custom/stats"]
    },

    "group/av": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "backlight"]
    },

    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "battery", "custom/power"]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated":   "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated":   "Idle inhibitor on",
        "tooltip-format-deactivated": "Idle inhibitor off"
    },

    "custom/stats": {
        "exec": "~/.config/waybar/scripts/stats.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/hypr/scripts/toggle-btop.sh"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "show-passive-items": false
    },

    "pulseaudio": {
        "format": "{volume}%  <span size='x-large'>{icon}</span>",
        "format-bluetooth": "{volume}%  <span size='x-large'>󰂰</span>",
        "format-bluetooth-muted": "<span size='x-large'>󰝟</span>",
        "format-muted": "<span size='x-large'>󰝟</span>",
        "format-icons": {
            "headphone":  "󰋋",
            "hands-free": "󰋋",
            "headset":    "󰋎",
            "phone":      "󰏲",
            "portable":   "󰕾",
            "car":        "󰄋",
            "default":    ["󰕿", "󰖀", "󰕾"]
        },
        "on-click":       "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up":   "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃞", "󰃟", "󰃟", "󰃠", "󰃠", "󰃡", "󰃡", "󰃡"],
        "tooltip-format": "Brightness: {percent}%",
        "on-scroll-up":   "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "network": {
        "format-wifi":         "󰖩",
        "format-ethernet":     "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi":         "{essid}  {signalStrength}%\n↑{bandwidthUpBits} ↓{bandwidthDownBits}",
        "tooltip-format-ethernet":     "{ifname}: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click":       "~/.config/rofi/scripts/wifi-manager",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format":                          "󰂯",
        "format-connected":                "󰂱",
        "format-connected-battery":        "󰂱",
        "format-disabled":                 "󰂲",
        "format-off":                      "󰂲",
        "tooltip-format":                  "{status}",
        "tooltip-format-connected":        "{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected":         "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click":       "~/.config/hypr/scripts/toggle-bt.sh",
        "on-click-right": "blueman-manager"
    },

    "battery": {
        "states": {
            "warning":  30,
            "critical": 15
        },
        "format":          "{capacity}%  <span size='x-large'>{icon}</span>",
        "format-charging": "{capacity}%  <span size='x-large'>󰂄</span>",
        "format-plugged":  "{capacity}%  <span size='x-large'></span>",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-click":       "ghostty -e btop",
        "on-click-right": "~/.config/rofi/scripts/power-manager"
    },

    "custom/launcher": {
        "format": "󰍉",
        "on-click": "~/.config/rofi/scripts/app-launcher",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/rofi/scripts/power-manager",
        "tooltip": false
    }
}
