/*
 * Password prompt theme — input bar only, pywal colors injected at runtime via -theme-str
 */

* {
    bg:               #1a1426;
    bg-alt:           #2d2438;
    fg:               #9d8ba8;
    active:           #ff6b8a;

    font:             "Cascadia Code NF 13";
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
    background-color: @bg;
    text-color:       @fg;
}

window {
    location:         center;
    anchor:           center;
    width:            440px;
    border-radius:    8px;
    background-color: @bg;
}

mainbox {
    children:         [ inputbar ];
    background-color: transparent;
}

inputbar {
    background-color: @bg-alt;
    border:           2px solid;
    border-color:     @active;
    border-radius:    6px;
    padding:          6px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @active;
    padding:          6px 10px;
    font:             "Cascadia Code NF Bold 13";
}

entry {
    background-color: transparent;
    text-color:       @active;
    padding:          6px 4px;
    placeholder:      "Password…";
    placeholder-color: @fg;
}
