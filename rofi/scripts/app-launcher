#!/usr/bin/env python3

import subprocess
import os
import sys

sys.path.insert(0, os.path.dirname(__file__))
from utils import get_wal_theme_str

CONFIG_DIR = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
THEME = f"{CONFIG_DIR}/rofi/app-launcher.rasi"
FILE_SEARCH   = f"{CONFIG_DIR}/rofi/scripts/file-search"
FOLDER_SEARCH = f"{CONFIG_DIR}/rofi/scripts/folder-search"

mode_list = [
    "drun",
    "run",
    f"files:{FILE_SEARCH}",
    f"folders:{FOLDER_SEARCH}",
]

# Add calculator tab if rofi-calc plugin binary is available.
if os.path.exists("/usr/lib/rofi/calc.so") or os.path.exists("/usr/lib64/rofi/calc.so"):
    mode_list.append("calc")

cmd = [
    "rofi",
    "-show", "drun",
    "-modes", ",".join(mode_list),
    "-show-icons",
    "-theme", THEME,
]

wal = get_wal_theme_str()
if wal:
    cmd += ["-theme-str", wal]

subprocess.run(cmd)
